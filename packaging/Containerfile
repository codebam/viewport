# The Arch base image. It is overridable so a production build can name an
# immutable digest instead of a rolling tag:
#
#   podman build --build-arg ARCH_BASE='docker.io/library/archlinux:base-devel@sha256:<digest>' ...
#
# `latest` and `base-devel` move every day, so the default build is
# reproducible only as far as "whatever Arch shipped today". The digest is
# the pin that makes the provenance of the build inputs checkable; it is not
# committed here because Arch is rolling and no offline checkout can name
# today's digest. Production builds should supply it via ARCH_BASE (or from
# their own mirror) and record the digest used with the artifact.
ARG ARCH_BASE=docker.io/library/archlinux:base-devel
FROM ${ARCH_BASE}

# base-devel for makepkg itself; the rest is what the PKGBUILD declares, put in
# the image so a rebuild does not re-download them every time. makepkg
# --syncdeps installs anything still missing on top.
RUN pacman -Syu --noconfirm --disable-sandbox --needed \
      base-devel git rust cargo pkgconf clang \
      wayland wayland-protocols libxkbcommon pixman libdrm libinput seatd \
      systemd-libs mesa libglvnd vulkan-icd-loader vulkan-headers \
      wpewebkit glib2 json-glib libxcb xcb-util-wm pipewire shared-mime-info \
 && pacman -Scc --noconfirm

# makepkg refuses to run as root, and normally the answer is an unprivileged
# user in the image. That needs a second uid, and rootless podman on a host
# with no /etc/subuid range has exactly one — every file the build tried to
# give to another user would fail with EINVAL.
#
# So the guard comes out instead. This is a throwaway container that builds one
# package and is deleted; the PKGBUILD it runs is an ordinary one that anybody
# can build the ordinary way on a real Arch machine.
RUN sed -i 's/(( EUID == 0 ))/(( 0 ))/' /usr/bin/makepkg \
 && grep -q 'PKGEXT' /etc/makepkg.conf

# No Arch package is pinned here. The bindings are generated by bindgen 0.72 by
# way of pipewire-rs 0.9, which reads a current libclang — the 0.8 line pins
# bindgen 0.69, which against clang 22 emits `struct spa_pod_builder` as an
# opaque byte and fails to compile. That is why this package needs a tree with
# the 0.9 migration in it.

WORKDIR /pkg

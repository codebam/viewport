pkgbase = viewport-smithay-webkitgtk-bin
	pkgdesc = Wayland compositor whose shell is a web page — WebKitGTK, out of process (binary release)
	pkgver = 0.1.1
	pkgrel = 1
	url = https://github.com/codebam/viewport-smithay
	arch = x86_64
	license = GPL-3.0-or-later
	depends = wayland

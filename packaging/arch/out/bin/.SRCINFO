	depends = gtk4
	depends = shared-mime-info
	optdepends = xorg-xwayland: X11 clients
	optdepends = xdg-desktop-portal-gtk: the portal interfaces the compositor does not answer itself
	optdepends = vulkan-radeon: AMD hardware
	optdepends = vulkan-intel: Intel hardware
	optdepends = nvidia-utils: NVIDIA hardware, and hardware video decode with it
	optdepends = vulkan-virtio: a virtual machine with 3D acceleration
	optdepends = vulkan-swrast: software Vulkan, for tests rather than a session
	optdepends = libva-mesa-driver: hardware video decode, for zero-copy video
